@model GymManagement.ViewModels.Account.ChangePasswordVM
@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-bg"></div>
    <div class="auth-card">
        <div class="auth-logo">
            <i class="fas fa-lock brand-icon"></i>
            <span class="brand-name">Change<span class="accent">Password</span></span>
        </div>
        <h1 class="auth-title">Update Your Password</h1>
        <p class="auth-subtitle">Keep your account secure with a strong password</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert-toast alert-success" style="margin-bottom:20px">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
            </div>
        }

        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            @if (!ViewContext.ModelState.IsValid && ViewContext.ModelState.Values.SelectMany(v => v.Errors).Any(e => e.ErrorMessage != ""))
            {
                <div class="alert-toast alert-error" style="margin-bottom:16px;display:flex;flex-direction:column;align-items:flex-start;gap:4px">
                    <div style="display:flex;align-items:center;gap:8px;font-weight:700"><i class="fas fa-exclamation-circle"></i> Password update failed</div>
                    @foreach (var error in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div style="font-size:0.85rem;padding-left:4px">• @error.ErrorMessage</div>
                    }
                </div>
            }

            <div class="form-group">
                <label class="form-label" asp-for="CurrentPassword">
                    <i class="fas fa-key"></i> Current Password
                </label>
                <input asp-for="CurrentPassword" class="form-control" type="password"
                       placeholder="Enter your current password" id="current-password" />
                <span asp-validation-for="CurrentPassword" class="field-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="NewPassword">
                    <i class="fas fa-lock"></i> New Password
                </label>
                <input asp-for="NewPassword" class="form-control" type="password"
                       placeholder="Minimum 6 characters" id="new-password" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="ConfirmNewPassword">
                    <i class="fas fa-check-double"></i> Confirm New Password
                </label>
                <input asp-for="ConfirmNewPassword" class="form-control" type="password"
                       placeholder="Repeat new password" id="confirm-password" />
                <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn-primary" id="change-pass-btn"
                    style="width:100%;justify-content:center;border-radius:var(--radius-sm);margin-top:8px">
                <i class="fas fa-shield-alt"></i> Update Password
            </button>
        </form>

        <div class="auth-footer" style="margin-top:20px">
            <p><a href="javascript:history.back()"><i class="fas fa-arrow-left"></i> Go Back</a></p>
        </div>
    </div>
</div>
