@model GymManagement.ViewModels.Account.LoginVM
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
    var regSuccess = TempData["RegistrationSuccess"] as string;
}

@* ── SUCCESS POPUP TOAST ── *@
@if (!string.IsNullOrEmpty(regSuccess))
{
    <div id="successToast" class="success-toast-overlay">
        <div class="success-toast-box">
            <div class="success-toast-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <h3 class="success-toast-title">Registration Successful!</h3>
            <p class="success-toast-msg">🎉 Welcome to <strong>PowerFit Gym</strong>!<br />Your account is ready. Please log in to get started.</p>
            <button class="success-toast-btn" onclick="closeToast()">
                <i class="fas fa-sign-in-alt"></i> Go to Login
            </button>
        </div>
    </div>
}

<div class="auth-page">
    <div class="auth-bg"></div>
    <div class="auth-card">
        <div class="auth-logo">
            <i class="fas fa-dumbbell brand-icon"></i>
            <span class="brand-name">PowerFit<span class="accent">Gym</span></span>
        </div>
        <h1 class="auth-title">Welcome Back</h1>
        <p class="auth-subtitle">Sign in to your account to continue</p>

        <form asp-action="Login" method="post">
            <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert-toast alert-error" style="display:@(ViewContext.ModelState.IsValid ? "none" : "flex")"></div>

            <div class="form-group">
                <label class="form-label" asp-for="Email"><i class="fas fa-envelope"></i> Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="admin@gmail.com" id="email-input" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Password"><i class="fas fa-lock"></i> Password</label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" id="password-input" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="form-group" style="display:flex;align-items:center;justify-content:space-between">
                <label style="display:flex;align-items:center;gap:8px;font-size:0.85rem;color:var(--text-secondary);cursor:pointer">
                    <input asp-for="RememberMe" type="checkbox" style="accent-color:var(--accent)" />
                    Remember me
                </label>
            </div>

            <button type="submit" class="btn-primary" style="width:100%;justify-content:center;border-radius:var(--radius-sm);margin-top:8px">
                <i class="fas fa-sign-in-alt"></i> Sign In
            </button>
        </form>

        <div class="auth-footer">
            <p>Don't have an account? <a asp-controller="Account" asp-action="Register">Register here</a></p>
        </div>

        <div style="margin-top:24px;padding:16px;background:rgba(8,8,18,0.7);border-radius:var(--radius-sm);border:1px solid rgba(255,255,255,0.08);backdrop-filter:blur(10px)">
            <p style="font-size:0.75rem;color:var(--text-muted);margin-bottom:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px">Demo Credentials</p>
            <div style="display:grid;gap:8px;font-size:0.8rem">
                <div style="display:flex;justify-content:space-between;align-items:center"><span style="color:var(--accent);font-weight:600">Admin</span><span style="color:var(--text-secondary)">admin@gmail.com / admin123</span></div>
                <div style="display:flex;justify-content:space-between;align-items:center"><span style="color:#60a5fa;font-weight:600">Trainer</span><span style="color:var(--text-secondary)">john.trainer@gym.com / Trainer@123</span></div>
                <div style="display:flex;justify-content:space-between;align-items:center"><span style="color:#4ade80;font-weight:600">Member</span><span style="color:var(--text-secondary)">alex.member@gym.com / Member@123</span></div>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
/* ── SUCCESS POPUP OVERLAY ── */
.success-toast-overlay {
    position: fixed; inset: 0; z-index: 9999;
    display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: fadeInOverlay 0.4s ease;
}
@@keyframes fadeInOverlay {
    from { opacity: 0; }
    to   { opacity: 1; }
}
.success-toast-box {
    background: rgba(10,10,18,0.95);
    border: 1px solid rgba(245,197,24,0.35);
    border-radius: 20px;
    padding: 48px 40px;
    max-width: 420px; width: 90%;
    text-align: center;
    box-shadow: 0 0 60px rgba(245,197,24,0.15), 0 32px 80px rgba(0,0,0,0.7);
    backdrop-filter: blur(20px);
    animation: popIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@@keyframes popIn {
    from { opacity: 0; transform: scale(0.7) translateY(30px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
}
.success-toast-icon {
    width: 80px; height: 80px;
    background: linear-gradient(135deg, rgba(245,197,24,0.2), rgba(245,197,24,0.05));
    border: 2px solid rgba(245,197,24,0.4);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 24px;
    animation: pulseRing 2s infinite;
}
@@keyframes pulseRing {
    0%, 100% { box-shadow: 0 0 0 0 rgba(245,197,24,0.3); }
    50%       { box-shadow: 0 0 0 14px rgba(245,197,24,0); }
}
.success-toast-icon i {
    font-size: 2.4rem;
    color: #f5c518;
}
.success-toast-title {
    font-size: 1.6rem; font-weight: 900;
    color: #ffffff; margin-bottom: 12px;
    letter-spacing: -0.3px;
}
.success-toast-msg {
    font-size: 0.95rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.7; margin-bottom: 32px;
}
.success-toast-msg strong { color: #f5c518; }
.success-toast-btn {
    background: #f5c518;
    color: #0a0a0f;
    border: none;
    padding: 14px 36px;
    border-radius: 50px;
    font-size: 0.95rem;
    font-weight: 800;
    cursor: pointer;
    font-family: inherit;
    display: inline-flex; align-items: center; gap: 10px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(245,197,24,0.3);
}
.success-toast-btn:hover {
    background: #e6b800;
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(245,197,24,0.4);
}
</style>
}

@section Scripts {
<script>
function closeToast() {
    const overlay = document.getElementById('successToast');
    if (!overlay) return;
    overlay.style.animation = 'fadeInOverlay 0.3s ease reverse';
    setTimeout(() => overlay.style.display = 'none', 280);
}
// Auto-close after 6 seconds
setTimeout(() => { if (document.getElementById('successToast')) closeToast(); }, 6000);
</script>
}
