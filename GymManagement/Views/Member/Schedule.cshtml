@model BLL.DTOs.MemberDTO
@{
    ViewData["Title"] = "My Schedule";
    Layout = "_MemberLayout";
    var shifts = ViewBag.Shifts as IEnumerable<BLL.DTOs.GymShiftDTO> ?? Enumerable.Empty<BLL.DTOs.GymShiftDTO>();
    var yogaSchedules = ViewBag.YogaSchedules as IEnumerable<BLL.DTOs.YogaScheduleDTO> ?? Enumerable.Empty<BLL.DTOs.YogaScheduleDTO>();
    var cardioSchedules = ViewBag.CardioSchedules as IEnumerable<BLL.DTOs.CardioScheduleDTO> ?? Enumerable.Empty<BLL.DTOs.CardioScheduleDTO>();
}

<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fas fa-calendar-check" style="color:var(--accent)"></i> My Schedule</h1>
        <p>Your gym shift, yoga, and cardio class schedule.</p>
    </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
    <!-- Membership Info -->
    <div class="form-card" style="grid-column:span 2">
        <h3 class="form-section-title" style="margin-top:0"><i class="fas fa-id-card"></i> Active Membership</h3>
        @if (Model.ActivePackageName != null)
        {
            <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px">
                <div style="background:rgba(200,135,42,0.08);border:1px solid rgba(200,135,42,0.2);border-radius:10px;padding:16px;text-align:center">
                    <div style="font-size:0.75rem;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin-bottom:6px">Package</div>
                    <div style="font-weight:800;color:var(--accent);font-size:1.1rem">@Model.ActivePackageName</div>
                </div>
                <div style="background:rgba(200,135,42,0.04);border:1px solid var(--border);border-radius:10px;padding:16px;text-align:center">
                    <div style="font-size:0.75rem;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin-bottom:6px">Start Date</div>
                    <div style="font-weight:700;font-size:0.95rem">@Model.MembershipStartDate?.ToString("MMM dd, yyyy")</div>
                </div>
                <div style="background:rgba(200,135,42,0.04);border:1px solid var(--border);border-radius:10px;padding:16px;text-align:center">
                    <div style="font-size:0.75rem;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin-bottom:6px">Expires</div>
                    <div style="font-weight:700;font-size:0.95rem">@Model.MembershipEndDate?.ToString("MMM dd, yyyy")</div>
                </div>
                <div style="background:rgba(@(Model.RemainingDays > 7 ? "34,139,34" : "200,60,60"),0.07);border:1px solid rgba(@(Model.RemainingDays > 7 ? "34,139,34" : "200,60,60"),0.22);border-radius:10px;padding:16px;text-align:center">
                    <div style="font-size:0.75rem;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin-bottom:6px">Days Left</div>
                    <div style="font-weight:800;color:@(Model.RemainingDays > 7 ? "#16a34a" : "#dc2626");font-size:1.3rem">@Model.RemainingDays</div>
                </div>
            </div>
        }
        else
        {
            <div style="text-align:center;padding:30px;color:var(--text-muted)">
                <i class="fas fa-exclamation-circle" style="font-size:2rem;margin-bottom:12px;display:block;color:#dc2626"></i>
                <p>No active membership found. Please contact admin to activate your membership.</p>
            </div>
        }
    </div>

    <!-- Gym Shift -->
    <div class="form-card">
        <h3 class="form-section-title" style="margin-top:0"><i class="fas fa-clock"></i> Gym Shift</h3>
        @if (!string.IsNullOrEmpty(Model.ShiftName))
        {
            <div style="display:flex;align-items:center;gap:16px">
                <div style="width:52px;height:52px;background:rgba(200,135,42,0.10);border:1px solid rgba(200,135,42,0.3);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    <i class="fas fa-sun" style="color:var(--accent);font-size:1.3rem"></i>
                </div>
                <div>
                    <div style="font-weight:800;font-size:1.1rem;margin-bottom:4px">@Model.ShiftName</div>
                    <div style="font-size:0.85rem;color:var(--text-secondary)">Your assigned gym shift</div>
                </div>
            </div>
        }
        else
        {
            <p style="color:var(--text-muted);font-size:0.9rem">No shift assigned yet.</p>
        }
    </div>

    <!-- Assigned Trainer -->
    <div class="form-card">
        <h3 class="form-section-title" style="margin-top:0"><i class="fas fa-user-tie"></i> Assigned Trainer</h3>
        @if (!string.IsNullOrEmpty(Model.AssignedTrainerName))
        {
            <div style="display:flex;align-items:center;gap:16px">
                <div class="avatar avatar-lg" style="flex-shrink:0">
                    @Model.AssignedTrainerName.FirstOrDefault()
                </div>
                <div>
                    <div style="font-weight:800;font-size:1.05rem;margin-bottom:4px">@Model.AssignedTrainerName</div>
                    <div style="font-size:0.85rem;color:var(--text-secondary)">Your personal trainer</div>
                </div>
            </div>
        }
        else
        {
            <div style="text-align:center;padding:20px;color:var(--text-muted)">
                <i class="fas fa-user-slash" style="font-size:1.8rem;margin-bottom:10px;display:block;opacity:0.4"></i>
                <p style="font-size:0.9rem">No trainer assigned yet.</p>
            </div>
        }
    </div>
</div>

@if (Model.ActivePackageName != null)
{
    <!-- Edit Schedule -->
    <div class="form-card" style="margin-top:24px">
        <h3 class="form-section-title" style="margin-top:0"><i class="fas fa-edit"></i> Edit My Schedule</h3>
        <p style="font-size:0.87rem;color:var(--text-secondary);margin-bottom:20px">
            Update your gym shift, yoga, or cardio class preferences. Changes take effect immediately.
        </p>
        <form asp-action="UpdateSchedule" method="post">
            @Html.AntiForgeryToken()
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-clock"></i> Gym Shift <span style="color:#dc2626">*</span></label>
                    <select name="shiftId" class="form-control" required id="edit-shift">
                        <option value="">-- Select a shift --</option>
                        @foreach (var shift in shifts)
                        {
                            if (Model.ShiftName == shift.ShiftName)
                            {
                                <option value="@shift.Id" selected>@shift.ShiftName (@shift.TimeRange)</option>
                            }
                            else
                            {
                                <option value="@shift.Id">@shift.ShiftName (@shift.TimeRange)</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-spa"></i> Yoga Class <span class="form-optional">(optional)</span></label>
                    <select name="yogaScheduleId" class="form-control" id="edit-yoga">
                        <option value="">-- None / Skip --</option>
                        @foreach (var yoga in yogaSchedules)
                        {
                            <option value="@yoga.Id">
                                @yoga.ClassName (@yoga.DayOfWeek @yoga.StartTime.ToString(@"hh\:mm") – @yoga.EndTime.ToString(@"hh\:mm"))
                            </option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-running"></i> Cardio Class <span class="form-optional">(optional)</span></label>
                    <select name="cardioScheduleId" class="form-control" id="edit-cardio">
                        <option value="">-- None / Skip --</option>
                        @foreach (var cardio in cardioSchedules)
                        {
                            <option value="@cardio.Id">
                                @cardio.ClassName (@cardio.DayOfWeek @cardio.StartTime.ToString(@"hh\:mm") – @cardio.EndTime.ToString(@"hh\:mm"))
                            </option>
                        }
                    </select>
                </div>
            </div>
            <div style="margin-top:8px;display:flex;gap:12px;align-items:center">
                <button type="submit" class="btn-primary" id="save-schedule-btn" style="border-radius:var(--radius-sm);padding:12px 28px">
                    <i class="fas fa-save"></i> Save Schedule Changes
                </button>
                <span style="font-size:0.82rem;color:var(--text-muted)">
                    <i class="fas fa-info-circle"></i> Trainer assignment is managed by Admin
                </span>
            </div>
        </form>
    </div>
}

