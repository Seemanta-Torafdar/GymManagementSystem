@model IEnumerable<BLL.DTOs.PaymentDTO>
@{
    ViewData["Title"] = "My Payments";
    Layout = "_MemberLayout";

    int? currentMonth = ViewBag.Month as int?;
    int? currentYear = ViewBag.Year as int?;

    var gymPayments = Model.Where(p => p.PackageName == null || !p.PackageName.StartsWith("PT Fee")).ToList();
    var ptPayments = Model.Where(p => p.PackageName != null && p.PackageName.StartsWith("PT Fee")).ToList();
}

<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fas fa-money-check-alt" style="color:var(--accent)"></i> My Payments</h1>
        <p>Track your gym membership and personal training payments.</p>
    </div>
</div>

<div class="card" style="padding:20px; margin-bottom:24px;">
    <form method="get" style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
        <div style="font-weight:700;color:var(--text-color)"><i class="fas fa-filter text-muted"></i> Filter Records:</div>
        
        <select name="month" class="form-control" style="width:150px">
            <option value="">All Months</option>
            @for (int i = 1; i <= 12; i++)
            {
                <option value="@i" selected="@(i == currentMonth)">@(new DateTime(2024, i, 1).ToString("MMMM"))</option>
            }
        </select>
        
        <select name="year" class="form-control" style="width:120px">
            <option value="">All Years</option>
            @for (int i = DateTime.Now.Year; i >= 2024; i--)
            {
                <option value="@i" selected="@(i == currentYear)">@i</option>
            }
        </select>

        <button type="submit" class="btn-primary btn-sm"><i class="fas fa-search"></i> Apply Filter</button>
        <a asp-action="Payments" class="btn-outline btn-sm"><i class="fas fa-undo"></i> Reset</a>
    </form>
</div>

<!-- Gym Payments Section -->
<div class="table-card" style="margin-bottom:30px">
    <div class="table-card-header">
        <span class="table-card-title"><i class="fas fa-id-card"></i> Gym Membership Payments</span>
    </div>
    <div style="overflow-x:auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Package</th>
                    <th>Total Amount</th>
                    <th>Amount Paid</th>
                    <th>Status</th>
                    <th>Payment Date</th>
                    <th>Method</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in gymPayments)
                {
                    var badgeClass = p.PaymentStatus == "Paid" ? "badge-success" : p.PaymentStatus == "Partial Paid" ? "badge-warning" : "badge-danger";
                    <tr>
                        <td><strong>@(p.PackageName ?? "Membership")</strong></td>
                        <td style="font-weight:600">৳@p.TotalAmount.ToString("N0")</td>
                        <td style="color:#4ade80;font-weight:600">৳@p.AmountPaid.ToString("N0")</td>
                        <td><span class="badge @badgeClass">@p.PaymentStatus</span></td>
                        <td style="font-size:0.85rem;color:var(--text-muted)">@(p.PaymentDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                        <td style="font-size:0.85rem;color:var(--text-muted)">@p.PaymentMethod</td>
                    </tr>
                }
                @if (!gymPayments.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align:center;padding:30px;color:var(--text-muted)">
                            No gym membership payments found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

