@model BLL.DTOs.MemberDTO
@{
    ViewData["Title"] = "My Trainer";
    Layout = "_MemberLayout";
}

<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fas fa-user-tie" style="color:var(--accent)"></i> My Trainer</h1>
        <p>Your allocated personal trainer information</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.AssignedTrainerName) && Model.AssignedTrainerId.HasValue)
{
    <!-- Trainer Card -->
    <div class="card" style="padding:32px;max-width:680px;margin:0 auto">
        <div style="display:flex;align-items:center;gap:28px;flex-wrap:wrap">
            <div class="avatar avatar-xl" style="flex-shrink:0">
                @Model.AssignedTrainerName.FirstOrDefault()
            </div>
            <div style="flex:1;min-width:200px">
                <div style="font-size:0.75rem;text-transform:uppercase;letter-spacing:1.5px;color:var(--accent);font-weight:700;margin-bottom:6px">
                    <i class="fas fa-link"></i> Your Allocated Trainer
                </div>
                <h2 style="font-size:1.5rem;font-weight:800;margin-bottom:6px">@Model.AssignedTrainerName</h2>
                <p style="color:var(--text-muted);font-size:0.9rem;margin-bottom:20px">
                    This trainer has been assigned to you by the gym admin.
                </p>
                <a asp-action="TrainerProfile" asp-route-id="@Model.AssignedTrainerId" class="btn-primary" style="display:inline-flex;align-items:center;gap:8px">
                    <i class="fas fa-eye"></i> View Full Profile & Reviews
                </a>
            </div>
        </div>

        <div style="margin-top:32px;padding-top:24px;border-top:1px solid var(--border)">
            <h3 style="font-size:1rem;font-weight:700;margin-bottom:16px;color:var(--text-muted)">
                <i class="fas fa-info-circle"></i> What Your Trainer Can Do
            </h3>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px">
                <div style="padding:16px;background:var(--bg-secondary);border-radius:var(--radius);border:1px solid var(--border)">
                    <i class="fas fa-clipboard-list" style="color:var(--accent);font-size:1.2rem;margin-bottom:8px;display:block"></i>
                    <div style="font-weight:700;margin-bottom:4px">Workout Plans</div>
                    <div style="font-size:0.85rem;color:var(--text-muted)">Personalized exercise routines tailored for your goals</div>
                </div>
                <div style="padding:16px;background:var(--bg-secondary);border-radius:var(--radius);border:1px solid var(--border)">
                    <i class="fas fa-chart-line" style="color:var(--accent);font-size:1.2rem;margin-bottom:8px;display:block"></i>
                    <div style="font-weight:700;margin-bottom:4px">Progress Tracking</div>
                    <div style="font-size:0.85rem;color:var(--text-muted)">Monitor your improvements and milestones over time</div>
                </div>
                <div style="padding:16px;background:var(--bg-secondary);border-radius:var(--radius);border:1px solid var(--border)">
                    <i class="fas fa-heartbeat" style="color:var(--accent);font-size:1.2rem;margin-bottom:8px;display:block"></i>
                    <div style="font-weight:700;margin-bottom:4px">Health Guidance</div>
                    <div style="font-size:0.85rem;color:var(--text-muted)">Expert advice on nutrition and overall wellbeing</div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- No Trainer Assigned -->
    <div class="card" style="padding:60px;text-align:center;max-width:500px;margin:0 auto">
        <div style="width:80px;height:80px;background:rgba(200,135,42,0.1);border:2px dashed rgba(200,135,42,0.4);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px">
            <i class="fas fa-user-slash" style="font-size:2rem;color:rgba(200,135,42,0.5)"></i>
        </div>
        <h2 style="font-size:1.2rem;font-weight:700;margin-bottom:12px">No Trainer Allocated Yet</h2>
        <p style="color:var(--text-muted);font-size:0.9rem;line-height:1.6">
            You don't have a personal trainer assigned yet. Please contact the gym admin or front desk to request a trainer allocation.
        </p>
        <div style="margin-top:24px;padding:16px;background:var(--bg-secondary);border-radius:var(--radius);border:1px solid var(--border);text-align:left">
            <div style="font-size:0.8rem;font-weight:700;color:var(--text-muted);margin-bottom:8px">AVAILABLE TRAINERS</div>
            <p style="font-size:0.85rem;color:var(--text-muted);margin:0">
                <i class="fas fa-info-circle" style="color:var(--accent)"></i>
                Once the admin assigns a personal trainer to you, their details and profile will appear here.
            </p>
        </div>
    </div>
}
