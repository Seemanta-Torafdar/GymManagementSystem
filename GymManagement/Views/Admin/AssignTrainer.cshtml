@{
    ViewData["Title"] = "Assign Trainer";
    Layout = "_AdminLayout";
    var member = ViewBag.Member as BLL.DTOs.MemberDTO;
    var trainers = ViewBag.Trainers as IEnumerable<BLL.DTOs.TrainerDTO>;
}

<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fas fa-user-tie" style="color:var(--accent)"></i> Assign Trainer</h1>
        <p>Allocate a personal trainer to @member?.FullName</p>
    </div>
    <div class="page-actions">
        <a asp-action="MemberDetails" asp-route-id="@member?.Id" class="btn-secondary"><i class="fas fa-arrow-left"></i> Back</a>
    </div>
</div>

<div class="form-container">
    <div class="form-card">
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid var(--border)">
            <div class="avatar avatar-lg">
                @if (!string.IsNullOrEmpty(member?.ProfilePhoto))
                { <img src="@member.ProfilePhoto" alt="@member.FullName" /> }
                else { @member?.FirstName?.FirstOrDefault() }
            </div>
            <div>
                <h3 style="margin:0;font-size:1.2rem">@member?.FullName</h3>
                <span style="color:var(--text-muted);font-size:0.9rem">@member?.Email • @member?.Phone</span>
            </div>
        </div>

        <form asp-action="AssignTrainer" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="memberId" value="@member?.Id" />

            <div class="form-group">
                <label class="form-label">Select Trainer</label>
                <select name="trainerId" class="form-control" required id="trainerSelect">
                    <option value="">-- Choose a Trainer --</option>
                    @if(trainers != null)
                    {
                        foreach (var trainer in trainers)
                        {
                            <option value="@trainer.Id" data-charge="@trainer.TrainingCharge">@trainer.FullName - @trainer.Specialization (@trainer.AssignedMembersCount students) — Default: ৳@trainer.TrainingCharge.ToString("N0")</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Personal Training Charge (Monthly) <span style="color:var(--accent);font-weight:600">৳</span></label>
                <input type="number" name="personalTrainingCharge" id="ptCharge" class="form-control" min="0" step="100" value="0" required />
                <div class="form-hint">Monthly fee for this student. Defaults to trainer's rate but you can customize it per student.</div>
            </div>

            <div class="form-group">
                <label class="form-label">Initial Workout Plan (Optional URL)</label>
                <input type="url" name="workoutPlan" class="form-control" placeholder="e.g. https://docs.google.com/..." />
                <div class="form-hint">Link to a shared document or spreadsheet with the workout plan.</div>
            </div>

            <div class="form-group">
                <label class="form-label">Initial Notes (Optional)</label>
                <textarea name="notes" class="form-control" rows="4" placeholder="Any specific goals, medical conditions, or focus areas..."></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary">Assign Trainer</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('trainerSelect').addEventListener('change', function () {
        var selected = this.options[this.selectedIndex];
        var charge = selected.getAttribute('data-charge') || '0';
        document.getElementById('ptCharge').value = charge;
    });
</script>

