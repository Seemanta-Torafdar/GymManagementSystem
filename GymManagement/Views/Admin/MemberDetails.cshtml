@model BLL.DTOs.MemberDTO
@{
    ViewData["Title"] = "Member Details";
    Layout = "_AdminLayout";
}
<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fas fa-user" style="color:var(--accent)"></i> Member Details</h1>
        <p>@Model.FullName</p>
    </div>
    <div class="page-actions">
        <a asp-action="EditMember" asp-route-id="@Model.Id" class="btn-outline"><i class="fas fa-pencil"></i> Edit</a>
        <a asp-action="RenewMembership" asp-route-memberId="@Model.Id" class="btn-primary"><i class="fas fa-rotate"></i> Renew</a>
        <a asp-action="AssignTrainer" asp-route-memberId="@Model.Id" class="btn-secondary"><i class="fas fa-user-tie"></i> Assign Trainer</a>
        <a asp-action="Members" class="btn-secondary"><i class="fas fa-arrow-left"></i> Back</a>
    </div>
</div>

<!-- Profile Header -->
<div class="profile-header">
    <div class="profile-photo-section">
        <div class="avatar avatar-xl">
            @if (!string.IsNullOrEmpty(Model.ProfilePhoto))
            { <img src="@Model.ProfilePhoto" alt="@Model.FullName" /> }
            else { @Model.FirstName.FirstOrDefault() }
        </div>
        <div style="margin-top:12px;font-size:0.8rem;color:var(--text-muted)">@Model.Gender</div>
        @if (Model.IsActive)
        { <span class="badge badge-success" style="margin-top:6px"><i class="fas fa-circle"></i> Active</span> }
        else
        { <span class="badge badge-danger" style="margin-top:6px">Inactive</span> }
    </div>
    <div style="flex:1">
        <h2 style="font-size:1.4rem;font-weight:800;margin-bottom:4px">@Model.FullName</h2>
        <p style="color:var(--text-muted);margin-bottom:20px">@Model.Email • Joined @Model.JoinDate.ToString("MMM dd, yyyy")</p>
        <div class="profile-info-grid">
            <div class="profile-info-item"><div class="info-label">Phone</div><div class="info-value">@Model.Phone</div></div>
            <div class="profile-info-item"><div class="info-label">Date of Birth</div><div class="info-value">@Model.DateOfBirth.ToString("MMM dd, yyyy")</div></div>
            <div class="profile-info-item"><div class="info-label">Blood Group</div><div class="info-value">@(Model.BloodGroup ?? "—")</div></div>
            <div class="profile-info-item"><div class="info-label">Address</div><div class="info-value">@(Model.Address ?? "—")</div></div>
            <div class="profile-info-item"><div class="info-label">Emergency Contact</div><div class="info-value">@(Model.EmergencyContact ?? "—")</div></div>
            <div class="profile-info-item"><div class="info-label">Emergency Phone</div><div class="info-value">@(Model.EmergencyPhone ?? "—")</div></div>
        </div>
    </div>
</div>

<!-- Membership Info -->
<div class="membership-card">
    <h3 style="font-size:0.9rem;font-weight:700;margin-bottom:20px;color:var(--accent);text-transform:uppercase;letter-spacing:1px"><i class="fas fa-id-card"></i> Membership Status</h3>
    <div class="membership-card-grid">
        <div class="membership-info-item">
            <div class="membership-info-label">Package</div>
            <div class="membership-info-value">@(Model.ActivePackageName ?? "No Package")</div>
        </div>
        <div class="membership-info-item">
            <div class="membership-info-label">Start Date</div>
            <div class="membership-info-value">@(Model.MembershipStartDate?.ToString("MMM dd, yyyy") ?? "—")</div>
        </div>
        <div class="membership-info-item">
            <div class="membership-info-label">Expiry Date</div>
            <div class="membership-info-value">@(Model.MembershipEndDate?.ToString("MMM dd, yyyy") ?? "—")</div>
        </div>
        <div class="membership-info-item">
            <div class="membership-info-label">Days Remaining</div>
            <div class="membership-info-value big">@(Model.RemainingDays?.ToString() ?? "0")</div>
        </div>
        <div class="membership-info-item">
            <div class="membership-info-label">Gym Shift</div>
            <div class="membership-info-value">@(Model.ShiftName ?? "—")</div>
        </div>
        <div class="membership-info-item">
            <div class="membership-info-label">Assigned Trainer</div>
            <div class="membership-info-value">@(Model.AssignedTrainerName ?? "Not assigned")</div>
        </div>
        <div class="membership-info-item">
            <div class="membership-info-label">Payment Status</div>
            <div class="membership-info-value">
                @if (Model.PaymentStatus == "Paid")
                { <span class="badge badge-success">Paid</span> }
                else
                { <span class="badge badge-warning">Pending</span> }
            </div>
        </div>
    </div>
</div>
