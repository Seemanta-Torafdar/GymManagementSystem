@model IEnumerable<BLL.DTOs.EquipmentDTO>
@{
    ViewData["Title"] = "Equipment";
    Layout = "_AdminLayout";
}
<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fas fa-dumbbell" style="color:var(--accent)"></i> Equipment</h1>
        <p>Manage gym equipment inventory</p>
    </div>
    <div class="page-actions">
        <a asp-action="CreateEquipment" class="btn-primary"><i class="fas fa-plus"></i> Add Equipment</a>
    </div>
</div>

<div class="grid-3">
    @foreach (var eq in Model)
    {
        <div class="equipment-card">
            <div class="equipment-img">
                @if (!string.IsNullOrEmpty(eq.ImagePath)) { <img src="@eq.ImagePath" alt="@eq.Name" /> }
                else { <i class="fas fa-dumbbell eq-icon"></i> }
            </div>
            <div class="equipment-info">
                <div class="equipment-name">@eq.Name</div>
                <div class="equipment-category">@eq.Category</div>
                <p class="equipment-desc" style="margin-top:12px">@eq.Description</p>
                <div style="margin-top:16px;display:flex;justify-content:space-between;align-items:center;padding-top:16px;border-top:1px solid var(--border)">
                    <div>
                        <span style="font-size:0.75rem;color:var(--text-muted);display:block">IN STOCK</span>
                        <span style="font-weight:700">@(eq.Quantity ?? 0)</span>
                    </div>
                    <div style="display:flex;gap:8px">
                        <a asp-action="EditEquipment" asp-route-id="@eq.Id" class="btn-sm btn-secondary"><i class="fas fa-pencil"></i></a>
                        <form asp-action="DeleteEquipment" method="post" style="display:inline">
                            <input type="hidden" name="id" value="@eq.Id" />
                            <button type="submit" class="btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
