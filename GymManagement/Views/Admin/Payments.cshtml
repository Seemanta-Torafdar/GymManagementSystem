@model IEnumerable<BLL.DTOs.PaymentDTO>
@{
    ViewData["Title"] = "Payments";
    Layout = "_AdminLayout";
    decimal revenue = ViewBag.MonthlyRevenue ?? 0m;
}
<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fas fa-money-bill-wave" style="color:var(--accent)"></i> Payments</h1>
        <p>Member payment records and status management</p>
    </div>
    <div class="page-actions">
        <div class="stat-card" style="padding:14px 20px;margin:0">
            <div class="revenue-display"><span class="currency">৳</span>@revenue.ToString("N0")</div>
            <div class="stat-label">This Month's Revenue</div>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="table-card-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
        <span class="table-card-title">All Payments (@Model.Count())</span>
        
        <form method="get" action="/Admin/Payments" style="display:flex; gap:10px; align-items:center">
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Search by name or notes..." class="form-control" style="width:200px" />
            <select name="month" class="form-control">
                <option value="">-- All Months --</option>
                @for(int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(ViewBag.Month == m ? "selected" : null)">
                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
                    </option>
                }
            </select>
            <input type="number" name="year" value="@ViewBag.Year" placeholder="Year" class="form-control" style="width:100px" />
            <button type="submit" class="btn-primary" style="padding:8px 16px"><i class="fas fa-filter"></i> Filter</button>
            @if(ViewBag.Search != null || ViewBag.Month != null || ViewBag.Year != null)
            {
                <a asp-action="Payments" class="btn-secondary" style="padding:8px 16px">Clear</a>
            }
        </form>
    </div>
    <div style="overflow-x:auto">
        <table class="data-table">
            <thead><tr><th>Member</th><th>Amount</th><th>Due Date</th><th>Status</th><th>Payment Date</th><th>Method</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><strong>@p.MemberName</strong></td>
                        <td style="font-weight:700;color:#4ade80">৳@p.Amount.ToString("N0")</td>
                        <td>@p.DueDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (p.Status == "Paid")
                            { <span class="badge badge-success"><i class="fas fa-check"></i> Paid</span> }
                            else
                            { <span class="badge badge-warning"><i class="fas fa-clock"></i> Pending</span> }
                        </td>
                        <td>@(p.PaymentDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                        <td>@(p.PaymentMethod ?? "Cash")</td>
                        <td>
                            <div class="table-actions">
                                @if (p.Status == "Pending")
                                {
                                    <form asp-action="MarkPaid" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" class="btn-success btn-sm"><i class="fas fa-check"></i> Mark Paid</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="MarkUnpaid" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" class="btn-danger btn-sm"><i class="fas fa-times"></i> Mark Unpaid</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" style="text-align:center;padding:40px;color:var(--text-muted)"><i class="fas fa-receipt" style="font-size:2rem;display:block;margin-bottom:12px;color:rgba(230,57,70,0.2)"></i>No payment records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
