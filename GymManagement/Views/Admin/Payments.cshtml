@model IEnumerable<BLL.DTOs.PaymentDTO>
@{
    ViewData["Title"] = "Member Payments";
    Layout = "_AdminLayout";
    decimal revenue = ViewBag.MonthlyRevenue ?? 0m;
}
<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fas fa-money-bill-wave" style="color:var(--accent)"></i> Member Payments</h1>
        <p>Track and manage member payment records</p>
    </div>
    <div class="page-actions">
        <div class="stat-card" style="padding:14px 20px;margin:0">
            <div class="revenue-display"><span class="currency">৳</span>@revenue.ToString("N0")</div>
            <div class="stat-label">This Month Revenue</div>
        </div>
    </div>
</div>

<div style="margin-bottom: 20px; display: flex; gap: 10px;">
    <a href="/Admin/Payments" class="btn @(string.IsNullOrEmpty(ViewBag.PaymentStatus) ? "btn-primary" : "btn-secondary")" style="padding: 10px 20px; font-weight: 600; border-radius: 8px;">All Payments</a>
    <a href="/Admin/Payments?paymentStatus=Paid" class="btn @(ViewBag.PaymentStatus == "Paid" ? "btn-primary" : "btn-secondary")" style="padding: 10px 20px; font-weight: 600; border-radius: 8px;"><i class="fas fa-check-circle" style="color: @(ViewBag.PaymentStatus == "Paid" ? "#fff" : "var(--success)");"></i> Paid Members</a>
    <a href="/Admin/Payments?paymentStatus=Unpaid" class="btn @(ViewBag.PaymentStatus == "Unpaid" ? "btn-primary" : "btn-secondary")" style="padding: 10px 20px; font-weight: 600; border-radius: 8px;"><i class="fas fa-exclamation-circle" style="color: @(ViewBag.PaymentStatus == "Unpaid" ? "#fff" : "var(--danger)");"></i> Unpaid Members</a>
</div>

<div class="table-card">
    <div class="table-card-header" style="flex-wrap:wrap;gap:12px">
        <span class="table-card-title">All Payments (@Model.Count())</span>
        <form method="get" action="/Admin/Payments" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Search member..." class="form-control" style="width:160px" />
            
            <select name="packageName" class="form-control" style="width:150px">
                <option value="">All Packages</option>
                @if (ViewBag.Packages != null)
                {
                    foreach (var pkg in ViewBag.Packages)
                    {
                        <option value="@pkg.Name" selected="@(ViewBag.PackageName == pkg.Name ? "selected" : null)">@pkg.Name</option>
                    }
                }
            </select>

            <select name="paymentStatus" class="form-control" style="width:130px">
                <option value="">All Statuses</option>
                <option value="Paid" selected="@(ViewBag.PaymentStatus == "Paid" ? "selected" : null)">Paid</option>
                <option value="Unpaid" selected="@(ViewBag.PaymentStatus == "Unpaid" ? "selected" : null)">Unpaid</option>
            </select>

            <input type="date" name="date" value="@ViewBag.Date" class="form-control" style="width:140px" />
            <select name="month" class="form-control" style="width:130px">
                <option value="">All Months</option>
                @for(int m = 1; m <= 12; m++){
                    <option value="@m" selected="@(ViewBag.Month == m ? "selected" : null)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                }
            </select>
            <input type="number" name="year" value="@ViewBag.Year" placeholder="Year" class="form-control" style="width:85px" />
            <button type="submit" class="btn-primary" style="padding:8px 14px"><i class="fas fa-filter"></i> Filter</button>
            @if(ViewBag.Search != null || ViewBag.Month != null || ViewBag.Year != null || ViewBag.Date != null || ViewBag.PackageName != null || ViewBag.PaymentStatus != null){
                <a asp-action="Payments" class="btn-secondary" style="padding:8px 14px">Clear</a>
            }
        </form>
    </div>
    <div style="overflow-x:auto">
        <table class="data-table">
            <thead><tr>
                <th>Member</th><th>Gym Package</th><th>Payment Type & Amount</th>
                <th>Status</th><th>Payment Date</th><th>Actions</th>
            </tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <strong>@p.MemberName</strong>
                            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 4px;">
                                @if(!string.IsNullOrEmpty(p.GymId)){ <div><i class="fas fa-id-badge"></i> @p.GymId</div> }
                                @if(!string.IsNullOrEmpty(p.MemberEmail)){ <div><i class="fas fa-envelope"></i> @p.MemberEmail</div> }
                            </div>
                        </td>
                        <td>
                            @(p.PackageName ?? "—")
                        </td>
                        <td>
                            <div style="font-weight:700;color:var(--text-primary)"><i class="fas fa-id-card"></i> Gym Package</div>
                            <div style="font-weight:800;font-size:1.1rem;margin-top:4px">৳@p.TotalAmount.ToString("N0")</div>
                        </td>
                        <td>
                            @if (p.PaymentStatus == "Paid")
                            { <span class="badge badge-success"><i class="fas fa-check"></i> Paid</span> }
                            else
                            { <span class="badge badge-danger"><i class="fas fa-times"></i> Unpaid</span> }
                        </td>
                        <td>@(p.PaymentDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                        <td>
                            @if (p.PaymentStatus != "Paid")
                            {
                                <form asp-action="MarkPaid" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button type="submit" class="btn-success btn-sm"><i class="fas fa-check"></i> Mark Paid</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="MarkUnpaid" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button type="submit" class="btn-danger btn-sm"><i class="fas fa-undo"></i> Mark Unpaid</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" style="text-align:center;padding:40px;color:var(--text-muted)">
                        <i class="fas fa-receipt" style="font-size:2rem;display:block;margin-bottom:12px;color:rgba(230,57,70,0.2)"></i>No payment records found.
                    </td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
