@model BLL.DTOs.GymSettingDTO
@{
    ViewData["Title"] = "System Settings";
    Layout = "_AdminLayout";
}
<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fas fa-cog" style="color:var(--accent)"></i> Gym Settings</h1>
        <p>Update system configuration and public website details</p>
    </div>
</div>

<div class="card">
    <form asp-action="Settings" method="post" enctype="multipart/form-data" class="grid-2">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        
        <div class="form-group">
            <label class="form-label">Gym Name</label>
            <input asp-for="GymName" class="form-control" required />
        </div>
        
        <div class="form-group">
            <label class="form-label">Hero Tagline</label>
            <input asp-for="HeroTagline" class="form-control" />
        </div>

        <div class="form-group">
            <label class="form-label">Contact Phone</label>
            <input asp-for="Phone" class="form-control" />
        </div>

        <div class="form-group">
            <label class="form-label">Contact Email</label>
            <input asp-for="Email" class="form-control" />
        </div>

        <div class="form-group" style="grid-column:1/-1">
            <label class="form-label">Address</label>
            <input asp-for="Address" class="form-control" />
        </div>

        <div class="form-group" style="grid-column:1/-1">
            <label class="form-label">About Us</label>
            <textarea asp-for="AboutUs" class="form-control" rows="4"></textarea>
        </div>

        <h3 class="form-section-title" style="grid-column:1/-1;margin-top:20px"><i class="fab fa-share-alt"></i> Social Links</h3>
        <div class="form-group"><label class="form-label">Facebook URL</label><input asp-for="FacebookUrl" class="form-control" /></div>
        <div class="form-group"><label class="form-label">Instagram URL</label><input asp-for="InstagramUrl" class="form-control" /></div>
        <div class="form-group"><label class="form-label">Twitter URL</label><input asp-for="TwitterUrl" class="form-control" /></div>
        <div class="form-group"><label class="form-label">YouTube URL</label><input asp-for="YouTubeUrl" class="form-control" /></div>

        <h3 class="form-section-title" style="grid-column:1/-1;margin-top:20px"><i class="fas fa-image"></i> Media & Branding</h3>
        <div class="form-group" style="grid-column:1/-1">
            <label class="form-label">Logo</label>
            @if(!string.IsNullOrEmpty(Model.LogoPath)) { <img src="@Model.LogoPath" style="height:50px;margin-bottom:10px;display:block" /> }
            <input type="file" name="logoFile" class="form-control" accept="image/*" />
        </div>
        
        <div class="form-group"><label class="form-label">Banner Image 1</label><input type="file" name="banner1" class="form-control" accept="image/*" /></div>
        <div class="form-group"><label class="form-label">Banner Image 2</label><input type="file" name="banner2" class="form-control" accept="image/*" /></div>
        <div class="form-group"><label class="form-label">Banner Image 3</label><input type="file" name="banner3" class="form-control" accept="image/*" /></div>

        <div class="form-actions" style="grid-column:1/-1;margin-top:20px">
            <button type="submit" class="btn-primary" style="padding:10px 24px"><i class="fas fa-save"></i> Save Settings</button>
        </div>
    </form>
</div>
