@model BLL.DTOs.MemberEditDTO
@{
    ViewData["Title"] = "Edit Member";
    Layout = "_AdminLayout";
}
<div class="page-header">
    <div class="page-header-left">
        <a asp-action="Members" style="color:var(--text-muted);font-size:0.9rem;margin-bottom:8px;display:inline-block"><i class="fas fa-arrow-left"></i> Back to Members</a>
        <h1><i class="fas fa-user-edit" style="color:var(--accent)"></i> Edit Member</h1>
    </div>
</div>

<div class="form-card" style="max-width:800px">
    <form asp-action="EditMember" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert-toast alert-error"></div>
        
        <h3 class="form-section-title">Personal Information</h3>
        <div class="form-grid">
            <div class="form-group">
                <label asp-for="FirstName" class="form-label">First Name</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="form-label">Last Name</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Phone" class="form-label">Phone</label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                <input asp-for="DateOfBirth" type="date" class="form-control" />
                <span asp-validation-for="DateOfBirth" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Gender" class="form-label">Gender</label>
                <select asp-for="Gender" class="form-control">
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
                <span asp-validation-for="Gender" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="BloodGroup" class="form-label">Blood Group <span class="form-optional">(optional)</span></label>
                <input asp-for="BloodGroup" class="form-control" />
                <span asp-validation-for="BloodGroup" class="field-error"></span>
            </div>
            <div class="form-group" style="grid-column: span 2">
                <label asp-for="Address" class="form-label">Address</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="field-error"></span>
            </div>
        </div>

        <h3 class="form-section-title">Emergency & Medical</h3>
        <div class="form-grid">
            <div class="form-group">
                <label asp-for="EmergencyContact" class="form-label">Emergency Contact Name <span class="form-optional">(optional)</span></label>
                <input asp-for="EmergencyContact" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="EmergencyPhone" class="form-label">Emergency Phone <span class="form-optional">(optional)</span></label>
                <input asp-for="EmergencyPhone" class="form-control" />
            </div>
            <div class="form-group" style="grid-column: span 2">
                <label asp-for="MedicalNotes" class="form-label">Medical Notes <span class="form-optional">(optional)</span></label>
                <textarea asp-for="MedicalNotes" class="form-control" rows="3"></textarea>
            </div>
        </div>

        <div style="margin-top:30px;display:flex;gap:12px">
            <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Save Changes</button>
            <a asp-action="Members" class="btn-secondary">Cancel</a>
        </div>
    </form>
</div>
