@model BLL.DTOs.MembershipPackageDTO
@{
    ViewData["Title"] = "Edit Package";
    Layout = "_AdminLayout";
}
<div class="page-header">
    <div class="page-header-left">
        <a asp-action="Memberships" style="color:var(--text-muted);font-size:0.9rem;margin-bottom:8px;display:inline-block"><i class="fas fa-arrow-left"></i> Back to Packages</a>
        <h1><i class="fas fa-tags" style="color:var(--accent)"></i> Edit Package</h1>
    </div>
</div>

<div class="form-card" style="max-width:800px">
    <form asp-action="EditPackage" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        
        <div class="form-grid">
            <div class="form-group" style="grid-column: span 2">
                <label asp-for="Name" class="form-label">Package Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="DurationDays" class="form-label">Duration (Days)</label>
                <input asp-for="DurationDays" type="number" class="form-control" />
                <span asp-validation-for="DurationDays" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="form-label">Price (৳)</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Price" class="field-error"></span>
            </div>
            <div class="form-group" style="grid-column: span 2">
                <label asp-for="Benefits" class="form-label">Benefits <span style="font-weight:normal;color:var(--text-muted);font-size:0.75rem">(Separate by semicolon ;)</span></label>
                <input asp-for="Benefits" class="form-control" />
            </div>
            <div class="form-group" style="grid-column: span 2">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="form-group" style="display:flex;align-items:center;grid-column: span 2">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                    <input asp-for="IsActive" type="checkbox" style="accent-color:var(--accent);width:18px;height:18px" />
                    <strong>Active (Available for purchase)</strong>
                </label>
            </div>
        </div>
        
        <div style="margin-top:30px;display:flex;gap:12px">
            <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Save Changes</button>
            <a asp-action="Memberships" class="btn-secondary">Cancel</a>
        </div>
    </form>
</div>
