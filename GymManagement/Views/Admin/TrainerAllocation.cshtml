@model IEnumerable<BLL.DTOs.MemberDTO>
@{
    ViewData["Title"] = "Trainer Allocation";
    Layout = "_AdminLayout";
    var trainers = ViewBag.Trainers as IEnumerable<BLL.DTOs.TrainerDTO> ?? new List<BLL.DTOs.TrainerDTO>();
}

<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fas fa-link" style="color:var(--accent)"></i> Trainer Allocation</h1>
        <p>Assign and manage personal trainers for all members in one place.</p>
    </div>
</div>

<!-- Summary Cards -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin-bottom:28px">
    @{
        int totalMembers = Model.Count();
        int assignedCount = Model.Count(m => !string.IsNullOrEmpty(m.AssignedTrainerName));
        int unassignedCount = totalMembers - assignedCount;
    }
    <div class="card" style="padding:20px;text-align:center">
        <div style="font-size:2rem;font-weight:800;color:var(--accent)">@totalMembers</div>
        <div style="font-size:0.85rem;color:var(--text-muted);margin-top:4px">Total Members</div>
    </div>
    <div class="card" style="padding:20px;text-align:center">
        <div style="font-size:2rem;font-weight:800;color:var(--success)">@assignedCount</div>
        <div style="font-size:0.85rem;color:var(--text-muted);margin-top:4px">Assigned</div>
    </div>
    <div class="card" style="padding:20px;text-align:center">
        <div style="font-size:2rem;font-weight:800;color:var(--danger)">@unassignedCount</div>
        <div style="font-size:0.85rem;color:var(--text-muted);margin-top:4px">Unassigned</div>
    </div>
    <div class="card" style="padding:20px;text-align:center">
        <div style="font-size:2rem;font-weight:800;color:var(--text)">@trainers.Count()</div>
        <div style="font-size:0.85rem;color:var(--text-muted);margin-top:4px">Available Trainers</div>
    </div>
</div>

<!-- Allocation Table -->
<div class="table-card">
    <div class="table-card-header">
        <span class="table-card-title">All Members & Trainer Assignments</span>
        <form method="get" class="search-box">
            <i class="fas fa-search"></i>
            <input name="search" type="text" placeholder="Search member..." value="@ViewBag.Search" id="alloc-search" />
            <button type="submit" style="background:none;border:none;color:var(--accent);cursor:pointer"><i class="fas fa-arrow-right"></i></button>
        </form>
    </div>
    <div style="overflow-x:auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Package</th>
                    <th>Allocated Trainer</th>
                    <th>Assigned On</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>
                            <div class="member-name-cell">
                                <div class="avatar">
                                    @if (!string.IsNullOrEmpty(m.ProfilePhoto))
                                    { <img src="@m.ProfilePhoto" alt="@m.FirstName" /> }
                                    else { @m.FirstName.FirstOrDefault() }
                                </div>
                                <div>
                                    <strong>@m.FullName</strong>
                                    <span>@m.Email</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (m.ActivePackageName != null) { @m.ActivePackageName }
                            else { <span class="badge badge-muted">No Package</span> }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(m.AssignedTrainerName))
                            {
                                <div style="display:flex;align-items:center;gap:10px">
                                    <div class="avatar" style="width:32px;height:32px;font-size:0.85rem">@m.AssignedTrainerName.FirstOrDefault()</div>
                                    <strong>@m.AssignedTrainerName</strong>
                                </div>
                            }
                            else
                            {
                                <span style="color:var(--text-muted);font-style:italic">Not assigned</span>
                            }
                        </td>
                        <td style="color:var(--text-muted);font-size:0.85rem">
                            @(m.AssignedTrainerName != null ? "Active" : "—")
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(m.AssignedTrainerName))
                            { <span class="badge badge-success"><i class="fas fa-check"></i> Assigned</span> }
                            else
                            { <span class="badge badge-danger"><i class="fas fa-times"></i> Unassigned</span> }
                        </td>
                        <td>
                            <div class="table-actions">
                                <a asp-action="AssignTrainer" asp-route-memberId="@m.Id" class="btn-sm-accent" title="Assign / Change Trainer">
                                    <i class="fas fa-user-tie"></i>
                                    @(string.IsNullOrEmpty(m.AssignedTrainerName) ? "Assign" : "Change")
                                </a>
                                <a asp-action="MemberDetails" asp-route-id="@m.Id" class="btn-sm btn-secondary" title="View Member">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" style="text-align:center;padding:40px;color:var(--text-muted)">
                        <i class="fas fa-users" style="font-size:2rem;display:block;margin-bottom:12px;opacity:0.3"></i>
                        No members found.
                    </td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
