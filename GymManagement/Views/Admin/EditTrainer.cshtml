@model BLL.DTOs.TrainerEditDTO
@{
    ViewData["Title"] = "Edit Trainer";
    Layout = "_AdminLayout";
}
<div class="page-header">
    <div class="page-header-left">
        <a asp-action="Trainers" style="color:var(--text-muted);font-size:0.9rem;margin-bottom:8px;display:inline-block"><i class="fas fa-arrow-left"></i> Back to Trainers</a>
        <h1><i class="fas fa-user-tie" style="color:var(--accent)"></i> Edit Trainer</h1>
    </div>
</div>

<div class="form-card" style="max-width:800px">
    <form asp-action="EditTrainer" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        
        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Specialization" class="form-label">Specialization</label>
                <input asp-for="Specialization" class="form-control" />
                <span asp-validation-for="Specialization" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Experience" class="form-label">Years of Experience</label>
                <input asp-for="Experience" type="number" class="form-control" />
                <span asp-validation-for="Experience" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="MonthlySalary" class="form-label">Monthly Salary (৳)</label>
                <input asp-for="MonthlySalary" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="MonthlySalary" class="field-error"></span>
            </div>
            <div class="form-group" style="display:flex;align-items:center">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                    <input asp-for="IsAvailable" type="checkbox" style="accent-color:var(--accent);width:18px;height:18px" />
                    <strong>Currently Available</strong>
                </label>
            </div>
            <div class="form-group" style="grid-column: span 2">
                <label class="form-label">Profile Photo</label>
                <input type="file" name="profilePhoto" class="form-control" accept="image/*" />
            </div>
            <div class="form-group" style="grid-column: span 2">
                <label asp-for="Certifications" class="form-label">Certifications</label>
                <input asp-for="Certifications" class="form-control" />
            </div>
            <div class="form-group" style="grid-column: span 2">
                <label asp-for="Bio" class="form-label">Bio / Description</label>
                <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
            </div>
        </div>
        
        <div style="margin-top:30px;display:flex;gap:12px">
            <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Save Changes</button>
            <a asp-action="Trainers" class="btn-secondary">Cancel</a>
        </div>
    </form>
</div>
