@model IEnumerable<BLL.DTOs.PaymentDTO>
@{
    ViewData["Title"] = "Personal Training";
    Layout = "_AdminLayout";
    var trainers = ViewBag.Trainers as IEnumerable<BLL.DTOs.TrainerDTO> ?? new List<BLL.DTOs.TrainerDTO>();
    var activeTrainerId = (int?)ViewBag.TrainerId;
    var activeTrainer = trainers.FirstOrDefault(t => t.Id == activeTrainerId);
    
    decimal totalDue = Model.Sum(p => p.DueAmount);
    decimal totalPaid = Model.Sum(p => p.AmountPaid);
    
    string currentStatus = ViewBag.PaymentStatus as string ?? "";
}

<div class="page-header">
    <div class="page-header-left">
        <h1><i class="fas fa-dumbbell" style="color:var(--accent)"></i> Personal Training Fees</h1>
        <p>Manage monthly PT fees for students assigned to trainers</p>
    </div>
</div>

<div class="stats-grid" style="margin-bottom:20px">
    <div class="stat-card"><div class="stat-card-icon blue"><i class="fas fa-users"></i></div><div class="stat-value">@Model.Count()</div><div class="stat-label">Students / Fees</div></div>
    <div class="stat-card"><div class="stat-card-icon green"><i class="fas fa-check-circle"></i></div><div class="stat-value">৳@totalPaid.ToString("N0")</div><div class="stat-label">Collected</div></div>
    <div class="stat-card"><div class="stat-card-icon red"><i class="fas fa-exclamation-circle"></i></div><div class="stat-value">৳@totalDue.ToString("N0")</div><div class="stat-label">Outstanding Due</div></div>
</div>

<div class="card" style="margin-bottom: 20px; padding: 15px 20px;">
    <form method="get" action="/Admin/PersonalTraining" style="display:flex; gap:15px; align-items:flex-end; flex-wrap:wrap">
        <input type="hidden" name="paymentStatus" value="@currentStatus" />
        <div style="flex-grow: 1; max-width: 400px;">
            <label style="display:block; margin-bottom: 8px; font-weight: 600; color: var(--text-secondary);">Select Trainer</label>
            <select name="trainerId" class="form-control" onchange="this.form.submit()" style="font-size: 1.05rem; padding: 10px;">
                @if(!trainers.Any()) {
                    <option value="">No trainers available</option>
                }
                @foreach (var t in trainers) { 
                    <option value="@t.Id" selected="@(activeTrainerId == t.Id ? "selected" : null)">@t.FullName (@t.Specialization)</option> 
                }
            </select>
        </div>
        
        <div>
            <label style="display:block; margin-bottom: 8px; font-weight: 600; color: var(--text-secondary);">Month</label>
            <select name="month" class="form-control" onchange="this.form.submit()" style="padding: 10px;">
                <option value="">All Months</option>
                @for (int m = 1; m <= 12; m++) {
                    <option value="@m" selected="@(ViewBag.Month == m ? "selected" : null)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                }
            </select>
        </div>
        
        <div>
            <label style="display:block; margin-bottom: 8px; font-weight: 600; color: var(--text-secondary);">Year</label>
            <input type="number" name="year" value="@ViewBag.Year" class="form-control" placeholder="Year" onchange="this.form.submit()" style="padding: 10px; width: 100px;" />
        </div>
        
        @if(ViewBag.Month != null || ViewBag.Year != null){
            <div>
                <a href="/Admin/PersonalTraining?trainerId=@activeTrainerId" class="btn btn-secondary" style="padding: 10px 15px;">Clear Filters</a>
            </div>
        }
    </form>
</div>

@if(activeTrainerId > 0)
{
    <div style="margin-bottom: 20px; display: flex; gap: 10px;">
        <a href="/Admin/PersonalTraining?trainerId=@activeTrainerId&month=@ViewBag.Month&year=@ViewBag.Year" class="btn @(string.IsNullOrEmpty(currentStatus) ? "btn-primary" : "btn-secondary")" style="padding: 10px 20px; font-weight: 600; border-radius: 8px;">All PT Fees</a>
        <a href="/Admin/PersonalTraining?trainerId=@activeTrainerId&paymentStatus=Paid&month=@ViewBag.Month&year=@ViewBag.Year" class="btn @(currentStatus == "Paid" ? "btn-primary" : "btn-secondary")" style="padding: 10px 20px; font-weight: 600; border-radius: 8px;"><i class="fas fa-check-circle" style="color: @(currentStatus == "Paid" ? "#fff" : "var(--success)");"></i> Paid</a>
        <a href="/Admin/PersonalTraining?trainerId=@activeTrainerId&paymentStatus=Unpaid&month=@ViewBag.Month&year=@ViewBag.Year" class="btn @(currentStatus == "Unpaid" ? "btn-primary" : "btn-secondary")" style="padding: 10px 20px; font-weight: 600; border-radius: 8px;"><i class="fas fa-exclamation-circle" style="color: @(currentStatus == "Unpaid" ? "#fff" : "var(--danger)");"></i> Unpaid</a>
    </div>

    <div class="table-card">
        <div class="table-card-header">
            <span class="table-card-title">Students for @(activeTrainer?.FullName)</span>
        </div>
        <div style="overflow-x:auto">
            <table class="data-table">
                <thead><tr>
                    <th>Student Name</th>
                    <th>Package Details</th>
                    <th>Amount & Due Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr></thead>
                <tbody>
                    @if (!Model.Any()) {
                        <tr><td colspan="5" style="text-align:center;padding:40px;color:var(--text-muted)">No PT fees found for this trainer based on the current filters.</td></tr>
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <strong>@p.MemberName</strong>
                                <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 4px;">
                                    @if(!string.IsNullOrEmpty(p.GymId)){ <div><i class="fas fa-id-badge"></i> @p.GymId</div> }
                                    @if(!string.IsNullOrEmpty(p.MemberEmail)){ <div><i class="fas fa-envelope"></i> @p.MemberEmail</div> }
                                </div>
                            </td>
                            <td>
                                <div style="font-weight:600; color:var(--text-primary)">@(p.PackageName ?? "Personal Training Fee")</div>
                                @if(!string.IsNullOrEmpty(p.Notes)) {
                                    <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 4px;">@p.Notes</div>
                                }
                            </td>
                            <td>
                                <div style="font-weight:700;font-size:1.1rem;color:var(--accent)">৳@p.TotalAmount.ToString("N0")</div>
                                <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 4px;">Due: @p.DueDate.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td>
                                @if (p.PaymentStatus == "Paid") { 
                                    <span class="badge badge-success"><i class="fas fa-check"></i> Paid</span> 
                                    <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 4px;">@p.PaymentDate?.ToString("MMM dd")</div>
                                }
                                else { 
                                    <span class="badge badge-danger"><i class="fas fa-times"></i> Unpaid</span> 
                                }
                            </td>
                            <td>
                                @if (p.PaymentStatus != "Paid")
                                {
                                    <form asp-action="MarkPTPaid" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="hidden" name="trainerId" value="@activeTrainerId" />
                                        <button type="submit" class="btn-success btn-sm"><i class="fas fa-check"></i> Mark Paid</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="MarkPTUnpaid" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="hidden" name="trainerId" value="@activeTrainerId" />
                                        <button type="submit" class="btn-outline-danger btn-sm" onclick="return confirm('Mark this PT fee as unpaid?');"><i class="fas fa-undo"></i> Mark Unpaid</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card" style="padding: 40px; text-align: center;">
        <i class="fas fa-dumbbell" style="font-size: 3rem; color: var(--border); margin-bottom: 20px;"></i>
        <h2 style="color: var(--text-secondary);">No Trainers Found</h2>
        <p>You need to create at least one trainer and assign them to a member.</p>
    </div>
}
